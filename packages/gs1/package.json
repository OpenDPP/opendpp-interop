{
  "name": "@opendpp/gs1",
  "version": "0.2.1",
  "description": "Pure, zero-dependency GS1 Digital Link URI builders and GS1 mod-10 check-digit helpers — validate AND mint GTIN-14/GLN-13 (ESM, Node >=26). Extracted from the OpenDPP Digital Product Passport service.",
  "keywords": [
    "gs1",
    "digital-link",
    "gtin",
    "gln",
    "grai",
    "check-digit",
    "mod-10",
    "dpp",
    "digital-product-passport",
    "espr",
    "esm"
  ],
  "license": "Apache-2.0",
  "author": "Giovanni Savastano <giovanni.savastano@opendpp-node.eu>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenDPP/opendpp-interop.git",
    "directory": "packages/gs1"
  },
  "homepage": "https://github.com/OpenDPP/opendpp-interop#readme",
  "bugs": {
    "url": "https://github.com/OpenDPP/opendpp-interop/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'test/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
