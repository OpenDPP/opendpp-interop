{
  "name": "@opendpp/interop-validate",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Validate AAS / UNTP DPP / CIRPASS-2-pointer output against the official schemas OpenDPP's CI uses, plus OpenDPP's own non-normative SHACL shapes — offline, no product source required.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OpenDPP/opendpp-interop",
  "bin": {
    "opendpp-interop-validate": "./validate.mjs"
  },
  "scripts": {
    "validate": "node validate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zazuko/env-node": "^3.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gs1encoder": "^1.4.1",
    "jsonld": "^9.0.0",
    "rdf-validate-shacl": "^0.6.5"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "undici": "^6.28.0"
  }
}
